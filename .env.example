# NocoDB — RadarGas Blog CMS
NOCODB_API_URL=https://optima-nocodb.vhsxer.easypanel.host
NOCODB_API_TOKEN=tu_token_aqui
NOCODB_BLOG_TABLE_ID=tu_table_id

# Groq — Auto-News AI Rewriter
GROQ_API_KEY=tu_api_key_aqui

# Google Search Console API (scripts/gsc.mjs)
